# Set variables in the API and worker terminals before starting them.
# DATA_DIR is resolved relative to the process working directory.
DATA_DIR=data
MAX_UPLOAD_MB=25
FRONTEND_ORIGIN=http://localhost:5173
# Optional: set this in the frontend environment to override same-origin API requests.
# VITE_API_URL=http://127.0.0.1:8000
# Required for automatic OpenAI generation after upload. Never commit the real key.
# OPENAI_API_KEY=your-key-here
# OPENAI_MODEL=gpt-4o-mini
