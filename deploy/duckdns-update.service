[Unit]
Description=Update Vedanta DuckDNS address
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
EnvironmentFile=/etc/vedanta/duckdns.env
ExecStart=/usr/bin/python3 /opt/vedanta/deploy/duckdns-update.py
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
